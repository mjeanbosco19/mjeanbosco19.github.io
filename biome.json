{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!out",
      "!.next",
      "!node_modules",
      "!**/*.md",
      "!next-env.d.ts",
      "!src/content/status.json",
      "!test-results",
      "!playwright-report",
      "!.lighthouseci"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
}
